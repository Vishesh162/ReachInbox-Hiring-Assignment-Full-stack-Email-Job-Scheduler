# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_db?schema=public"

# Redis (BullMQ + Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Elasticsearch
ELASTICSEARCH_NODE="http://localhost:9200"

# Queue & Worker Settings
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR=1000

# Authentication (Google OAuth v2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JWT_SECRET="reachinbox_super_secret_jwt_key_2026_production"

# Slack OAuth v2 & Alerts
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/oauth/callback"

# Server Ports
PORT=5000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:5000"
